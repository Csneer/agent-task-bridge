      "context": {
        "actor": {
          "kind": "agent",
          "id": "sensor-two"
        },
        "can_execute": false,
        "can_read_history": true
      },
      "expect": {
        "state": "submitted",
        "revision": 9,
        "replayed": true,
        "event_count": 10,
        "checks": [
          {
            "path": "event.event_id",
            "equals": "${new_device_submitted.event.event_id}"
