      "expect": {
        "error": "ROLE_MISMATCH",
        "event_count": 9,
        "snapshots": [
          {
            "task": {
              "authority_id": "device-demo",
              "task_id": "read-room-environment"
            },
            "state": "submitted",
            "revision": 9
          }
        ]
      }
    },
    {
      "id": "owner_accepts_reading",
      "command": {
        "protocol_version": "task-core-draft-1",
        "command_id": "owner_accepts_reading",
        "task": {
          "authority_id": "device-demo",
          "task_id": "read-room-environment"
        },
        "expected_revision": "${new_device_submitted.task.revision}",
        "operation": "task.decide",
        "body": {
          "submission_id": "${new_device_submitted.task.pending_submission_id}",
          "outcome": "accepted",
          "reason": "个人查看实际采样记录后接受本次任务结果。"
